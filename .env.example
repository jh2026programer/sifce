# =====================================================================
# SIFCE - Guía de variables de entorno (raíz del proyecto)
#
# Solo hay DOS archivos .env reales, uno por cada parte que se ejecuta:
#
#   whatever/.env  <- copia de whatever/.env.example  (API Express + scripts de model/)
#   view/.env      <- copia de view/.env.example      (interfaz React + Vite)
#
# model/ no tiene .env propio: su conexión y sus scripts (db:create, db:seed)
# usan la configuración de whatever/.env.
#
# Este archivo NO lo lee ninguna aplicación: es el resumen de qué va en
# cada .env, para tenerlo a mano en un solo lugar.
#
# En Windows / PowerShell, desde la raíz del proyecto:
#   Copy-Item whatever\.env.example whatever\.env
#   Copy-Item view\.env.example view\.env
#
# NUNCA subas un .env real ni pegues claves reales en chats o documentos.
# Si una clave se expone, revócala y genera una nueva.
# =====================================================================

# ---------------------------------------------------------------------
# [whatever/.env] — lo mínimo para arrancar en local
# ---------------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sifce
DB_USER=sifce_user
DB_PASSWORD=change_me
JWT_SECRET=change-this-to-a-long-random-string
AI_PROVIDER=mock
AI_API_KEY=
# Opcionales (ver whatever/.env.example): OTP_*, SMTP_*, CAPTCHA_*,
# LOGIN_MAX_ATTEMPTS, LOGIN_LOCK_MINUTES, RESUME_*, AI_MODEL, AI_API_URL.

# ---------------------------------------------------------------------
# [view/.env]
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api/v1
