# =====================================================================
# SIFCE API (whatever/) - Variables de entorno de ejemplo
# Copia este archivo como ".env" (en esta misma carpeta whatever/) y ajusta
# los valores. NUNCA subas tu archivo ".env" real a un repositorio.
# Los nombres coinciden exactamente con los que lee whatever/config/env.js.
# También lo usan los scripts de model/ (npm run db:create / db:seed).
# Después de cambiar el .env hay que REINICIAR la API (nodemon no lo recarga).
# =====================================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sifce
DB_USER=sifce_user
DB_PASSWORD=change_me

# --- Autenticación ---
# Genera un valor aleatorio largo, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# --- Carga de hojas de vida (PDF) ---
RESUME_MAX_SIZE_MB=5
RESUME_UPLOAD_DIR=uploads/resumes

# --- Módulo de Inteligencia Artificial (RNF-M3: independiente del proveedor) ---
# AI_PROVIDER:
#   mock      -> análisis determinístico por palabras clave, sin servicios
#                externos ni costo. Valor por defecto, ideal para demos.
#   groq      -> IA real, gratis dentro de los límites de Groq
#                (clave en https://console.groq.com/keys).
#   anthropic -> IA real con Claude (requiere AI_API_KEY).
#   openai    -> IA real con OpenAI (requiere AI_API_KEY).
#   http      -> tu propio servicio externo en AI_API_URL (contrato en docs/MODULO_IA.md).
AI_PROVIDER=mock
AI_API_KEY=
# Opcional: si se deja vacío, cada proveedor usa su modelo por defecto.
AI_MODEL=
# Solo para AI_PROVIDER=http
AI_API_URL=

# --- Microservicios (carpeta microservicios/, docs/MICROSERVICIOS.md) ---
# Se arrancan aparte con "npm run microservicios". Si se dejan vacías, o el
# microservicio no responde, la API usa su respaldo interno y sigue funcionando.
MS_COMPATIBILIDAD_URL=http://localhost:4101
MS_VALIDADOR_CV_URL=http://localhost:4102

# --- Verificación en dos pasos (OTP) al iniciar sesión ---
# Implementada pero desactivada por defecto. Ver docs/SEGURIDAD.md.
OTP_ENABLED=false
# "console": el código se imprime en la terminal del backend. "smtp": correo real.
OTP_NOTIFIER=console
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Correo real (solo si OTP_NOTIFIER=smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SIFCE <no-reply@sifce.local>

# --- CAPTCHA ("no soy un robot", Google reCAPTCHA v2) en los registros ---
# Desactivado por defecto: requiere claves gratuitas de
# https://www.google.com/recaptcha/admin/create (tipo "Casilla No soy un robot").
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Bloqueo de cuenta por intentos fallidos (fuerza bruta) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
